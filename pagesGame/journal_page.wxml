<view class="journal-container data-v-461d2b0f"><view class="header data-v-461d2b0f"><text class="title data-v-461d2b0f">探险手记</text><text class="subtitle data-v-461d2b0f">Aotai Archives</text></view><view class="stats-card data-v-461d2b0f"><view class="stat-item data-v-461d2b0f"><text class="label data-v-461d2b0f">尝试次数</text><text class="value data-v-461d2b0f">{{a}}</text></view><view class="stat-item data-v-461d2b0f"><text class="label data-v-461d2b0f">解锁结局</text><text class="value data-v-461d2b0f">{{b}} / {{c}}</text></view></view><text class="section-title data-v-461d2b0f">结局图鉴</text><view class="endings-grid data-v-461d2b0f"><view wx:for="{{d}}" wx:for-item="end" wx:key="e" class="{{['ending-card', 'data-v-461d2b0f', end.f && 'unlocked']}}"><view class="icon data-v-461d2b0f">{{end.a}}</view><text class="name data-v-461d2b0f">{{end.b}}</text><text wx:if="{{end.c}}" class="desc data-v-461d2b0f">{{end.d}}</text></view></view><text class="section-title data-v-461d2b0f">最近探险</text><view class="history-list data-v-461d2b0f"><view wx:if="{{e}}" class="empty-tip data-v-461d2b0f">暂无探险记录</view><view wx:for="{{f}}" wx:for-item="run" wx:key="e" class="history-item data-v-461d2b0f"><text class="date data-v-461d2b0f">{{run.a}}</text><view class="details data-v-461d2b0f"><text class="role data-v-461d2b0f">{{run.b}}</text><text class="days data-v-461d2b0f">生存 {{run.c}} 天</text></view><text class="result data-v-461d2b0f">{{run.d}}</text></view></view><button class="back-btn data-v-461d2b0f" bindtap="{{g}}">返回首页</button></view>